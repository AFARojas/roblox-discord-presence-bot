# Token de tu bot de Discord (se obtiene de Discord Developer Portal)
DISCORD_TOKEN=TU_DISCORD_BOT_TOKEN

# ID del canal de Discord donde se enviarán las alertas (Activa el Modo Desarrollador en Discord, clic derecho al canal -> Copiar ID)
DISCORD_CHANNEL_ID=TU_DISCORD_CHANNEL_ID

# ID de usuario numérico de Roblox a monitorear (Ejemplo: el ID que sale en la URL de tu perfil)
ROBLOX_USER_ID=ID_DE_USUARIO_ROBLOX

# Tiempo de espera entre consultas en milisegundos (Opcional, por defecto 30000 = 30 segundos)
POLL_INTERVAL=30000
